{
  "name": "@unscientificjszhai/howto",
  "version": "1.1.0",
  "type": "module",
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=22"
  },
  "description": "Use AI to quickly find commands within the terminal.",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/UnscientificJsZhai/HowTo.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "howto": "dist/index.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "npm run clean:dist && node ./node_modules/@typescript/native/bin/tsc",
    "build:test": "npm run clean:dist-test && node ./node_modules/@typescript/native/bin/tsc -p tsconfig.test.json",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:dist-test": "node -e \"require('node:fs').rmSync('dist-test', { recursive: true, force: true })\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "test": "npm run build:test && node --test dist-test/tests/unit/*.test.js dist-test/tests/unit/**/*.test.js dist-test/tests/integration/*.test.js dist-test/tests/integration/**/*.test.js",
    "test:integration": "npm run build:test && node --test dist-test/tests/integration/*.test.js dist-test/tests/integration/**/*.test.js",
    "test:package": "npm run build:test && node dist-test/tests/package-smoke.js",
    "test:unit": "npm run build:test && node --test dist-test/tests/unit/*.test.js dist-test/tests/unit/**/*.test.js",
    "check:toolchain": "node scripts/check-toolchain.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "ink": "^8.0.0",
    "jose": "^6.2.13",
    "openai": "^7.43.0",
    "react": "^19.3.1",
    "signal-exit": "^4.1.0",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": "prettier --write"
  }
}
